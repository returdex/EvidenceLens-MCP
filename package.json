{
  "name": "evidencelens-mcp",
  "version": "0.3.13",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "EVIDENCELENS_DISABLE_PROVIDER=1 vitest run --exclude tests/providers/deepseek-live.test.ts",
    "test:deepseek-live": "vitest run tests/providers/deepseek-live.test.ts",
    "docker:smoke": "bash scripts/docker-smoke.sh",
    "docker:review:real": "node scripts/docker-review-real.mjs",
    "docker:proof:produce-handoff": "node scripts/docker-proof-produce.mjs",
    "docker:proof:verify-handoff": "node scripts/docker-proof-verify-existing.mjs",
    "review:prepare-challenge-handoff": "node scripts/evidence-envelope.mjs prepare",
    "review:verify-challenge-handoff": "node scripts/evidence-envelope.mjs verify",
    "review:authorized-once": "node scripts/atomic-authorized-review.mjs",
    "review:auto-build": "node scripts/automatic-live-review.mjs auto-build",
    "review:auto-live-once": "node scripts/automatic-live-review.mjs auto-live-once",
    "test:e2e": "EVIDENCELENS_DISABLE_PROVIDER=1 vitest run tests/e2e/docker-review.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@napi-rs/canvas": "^1.0.7",
    "pdfjs-dist": "^6.2.108",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
