FROM node:22-bookworm-slim

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json ./
COPY src ./src
RUN npm run build && npm prune --omit=dev

COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
COPY tests/fixtures/evidence/text/assignment.txt /proof-fixtures/assignment.txt
COPY tests/fixtures/evidence/tables/rubric.csv /proof-fixtures/rubric.csv
COPY tests/fixtures/evidence/images/rubric-screenshot.png /proof-fixtures/rubric-screenshot.png
COPY tests/fixtures/evidence/pdfs/text-page.pdf /proof-fixtures/text-page.pdf
RUN chown root:root /proof-fixtures/* /usr/local/bin/docker-entrypoint.sh \
    && chmod 0444 /proof-fixtures/* \
    && chmod 0555 /usr/local/bin/docker-entrypoint.sh

USER node
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
